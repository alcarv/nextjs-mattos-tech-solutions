# URL publica usada no build para canonicals, sitemap e dados estruturados
NEXT_PUBLIC_SITE_URL=https://mattostechsolutions.com
# Opcional: a propriedade de dominio ja esta verificada no Search Console
GOOGLE_SITE_VERIFICATION=

# Formulário de contato (EmailJS)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Blog
NEXT_PUBLIC_SUPABASE_URL=
# Preferida para novos projetos/chaves (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Compatibilidade temporária com a chave anon legada
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Meta Pixel / Conversions API
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
# Segredo exclusivo do servidor; nunca usar o prefixo NEXT_PUBLIC_
META_CAPI_ACCESS_TOKEN=

# Somente para executar `npm run seo:validate` localmente; nao adicionar no Netlify
SEO_BASE_URL=http://localhost:3000
